:none}&#10; }&#10; &lt;/style&gt;&#10; &lt;section class="cs-sec" id="comece-por-aqui"&gt;&#10; &lt;div class="cs-head"&gt;&#10; &lt;h1&gt;Comece por aqui&lt;/h1&gt;&#10; &lt;span class="cs-count"&gt;3 cursos&lt;/span&gt;&#10; &lt;/div&gt;&#10; &lt;p class="cs-intro"&gt;Se você está começando do zero e quer uma trilha só, esses cursos podem ajudar. Os três cobrem uma boa introdução: visão geral, sintaxe, estatística aplicada e um primeiro modelo rodando.&lt;/p&gt;</description><media:content xmlns:media="http://search.yahoo.com/mrss/" url="https://gomesfellipe.github.io/courses/feature.jpg"/></item><item><title>Extensões do VSCode que uso</title><link>https://gomesfellipe.github.io/resources/vscode-extensions/</link><pubDate>Fri, 17 Jul 2026 00:00:00 +0000</pubDate><guid>https://gomesfellipe.github.io/resources/vscode-extensions/</guid><description>&lt;div class="vsx"&gt;&#10; &lt;style&gt;&#10; .vsx{&#10; --vsx-accent:#007acc; --vsx-accent2:#1f9cf0;&#10; --vsx-bg:#ffffff; --vsx-bg2:#faf7f2; --vsx-card:#ffffff;&#10; --vsx-text:#1f2733; --vsx-muted:#6b7583; --vsx-line:rgba(0,0,0,.09);&#10; --vsx-shadow:0 1px 2px rgba(0,0,0,.06),0 8px 24px rgba(0,0,0,.07);&#10; --vsx-shadow-h:0 6px 14px rgba(0,122,204,.18),0 18px 40px rgba(0,0,0,.14);&#10; width:100%; max-width:1180px; margin-inline:auto;&#10; color:var(--vsx-text); font-synthesis:none;&#10; }&#10; html.dark .vsx{&#10; --vsx-bg:#0f141b; --vsx-bg2:#141b24; --vsx-card:#1a2230;&#10; --vsx-text:#e6ebf2; --vsx-muted:#9aa6b4; --vsx-line:rgba(255,255,255,.10);&#10; --vsx-shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.5);&#10; --vsx-shadow-h:0 6px 16px rgba(31,156,240,.22),0 22px 46px rgba(0,0,0,.6);&#10; }&#10; .vsx *{box-sizing:border-box}&#10; .vsx-sec{margin-top:clamp(2rem,5vw,3rem)}&#10; .vsx-sec:first-child{margin-top:0}&#10; .vsx-sec-head{display:flex;align-items:baseline;gap:.6rem;flex-wrap:wrap;margin-bottom:1.4rem}&#10; .vsx-sec-head h1{margin:0;font-size:clamp(1.25rem,2.6vw,1.7rem);font-weight:800;letter-spacing:-.01em;border-bottom:none;padding-bottom:0}&#10; .vsx-sec-intro{flex-basis:100%;margin:.35rem 0 0;color:var(--vsx-muted);font-size:.96rem;line-height:1.55}&#10; .vsx-grid{display:grid;gap:1.1rem;grid-template-columns:repeat(auto-fill,minmax(240px,1fr))}&#10; .vsx-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--vsx-line);&#10; border-radius:16px;box-shadow:var(--vsx-shadow);transition:transform .2s,box-shadow .2s,border-color .2s;&#10; background:radial-gradient(140% 160% at 100% 100%,rgba(0,122,204,.10),transparent 55%),var(--vsx-card)}&#10; .vsx-card:hover{transform:translateY(-6px);box-shadow:var(--vsx-shadow-h);border-color:rgba(0,122,204,.4)}&#10; .vsx-top{display:flex;align-items:center;gap:.85rem;padding:1.1rem 1.1rem .6rem;position:relative}&#10; .vsx-icon{flex-shrink:0;width:52px;height:52px;border-radius:12px;overflow:hidden;&#10; display:flex;align-items:center;justify-content:center;background:var(--vsx-bg2);&#10; border:1px solid var(--vsx-line)}&#10; .vsx-icon img{width:100%;height:100%;object-fit:contain;padding:4px}&#10; .vsx-meta{min-width:0}&#10; .vsx-name{font-size:1rem;font-weight:700;line-height:1.2;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}&#10; .vsx-publisher{font-size:.8rem;color:var(--vsx-muted);margin:.1rem 0 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}&#10; .vsx-badge{position:absolute;top:.7rem;right:.7rem;font-size:.62rem;font-weight:800;&#10; letter-spacing:.03em;text-transform:uppercase;color:#fff;&#10; background:linear-gradient(120deg,var(--vsx-accent),var(--vsx-accent2));&#10; padding:.22rem .5rem;border-radius:999px;box-shadow:0 2px 8px rgba(0,122,204,.4)}&#10; .vsx-body{display:flex;flex-direction:column;gap:.35rem;padding:.2rem 1.1rem 1.1rem;flex:1}&#10; .vsx-pitch{font-size:.9rem;line-height:1.5;color:var(--vsx-text);opacity:.92;margin:.1rem 0 .8rem;flex:1}&#10; .vsx-cta{margin-top:auto;display:inline-flex;align-items:center;justify-content:center;gap: