<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel><title>Vscode on Fellipe Gomes</title><link>https://gomesfellipe.github.io/tags/vscode/</link><description>Recent content in Vscode on Fellipe Gomes</description><generator>Hugo -- gohugo.io</generator><language>pt-BR</language><copyright>© 2026 Fellipe Gomes</copyright><lastBuildDate>Fri, 24 Jul 2026 00:00:00 +0000</lastBuildDate><atom:link href="https://gomesfellipe.github.io/tags/vscode/index.xml" rel="self" type="application/rss+xml"/><item><title>Extensões do VSCode que uso</title><link>https://gomesfellipe.github.io/resources/vscode-extensions/</link><pubDate>Fri, 17 Jul 2026 00:00:00 +0000</pubDate><guid>https://gomesfellipe.github.io/resources/vscode-extensions/</guid><description>&lt;div class="vsx"&gt;&#10; &lt;style&gt;&#10; .vsx{&#10; --vsx-accent:#007acc; --vsx-accent2:#1f9cf0;&#10; --vsx-bg:#ffffff; --vsx-bg2:#faf7f2; --vsx-card:#ffffff;&#10; --vsx-text:#1f2733; --vsx-muted:#6b7583; --vsx-line:rgba(0,0,0,.09);&#10; --vsx-shadow:0 1px 2px rgba(0,0,0,.06),0 8px 24px rgba(0,0,0,.07);&#10; --vsx-shadow-h:0 6px 14px rgba(0,122,204,.18),0 18px 40px rgba(0,0,0,.14);&#10; width:100%; max-width:1180px; margin-inline:auto;&#10; color:var(--vsx-text); font-synthesis:none;&#10; }&#10; html.dark .vsx{&#10; --vsx-bg:#0f141b; --vsx-bg2:#141b24; --vsx-card:#1a2230;&#10; --vsx-text:#e6ebf2; --vsx-muted:#9aa6b4; --vsx-line:rgba(255,255,255,.10);&#10; --vsx-shadow:0 1px 2px rgba(0,0,0,.4),0 10px 30px rgba(0,0,0,.5);&#10; --vsx-shadow-h:0 6px 16px rgba(31,156,240,.22),0 22px 46px rgba(0,0,0,.6);&#10; }&#10; .vsx *{box-sizing:border-box}&#10; .vsx-sec{margin-top:clamp(2rem,5vw,3rem)}&#10; .vsx-sec:first-child{margin-top:0}&#10; .vsx-sec-head{display:flex;align-items:baseline;gap:.6rem;flex-wrap:wrap;margin-bottom:1.4rem}&#10; .vsx-sec-head h1{margin:0;font-size:clamp(1.25rem,2.6vw,1.7rem);font-weight:800;letter-spacing:-.01em;border-bottom:none;padding-bottom:0}&#10; .vsx-sec-intro{flex-basis:100%;margin:.35rem 0 0;color:var(--vsx-muted);font-size:.96rem;line-height:1.55}&#10; .vsx-grid{display:grid;gap:1.1rem;grid-template-columns:repeat(auto-fill,minmax(240px,1fr))}&#10; .vsx-card{display:flex;flex-direction:column;overflow:hidden;border:1px solid var(--vsx-line);&#10; border-radius:16px;box-shadow:var(--vsx-shadow);transition:transform .2s,box-shadow .2s,border-color .2s;&#10; background:radial-gradient(140% 160% at 100% 100%,rgba(0,122,204,.10),transparent 55%),var(--vsx-card)}&#10; .vsx-card:hover{transform:translateY(-6px);box-shadow:var(--vsx-shadow-h);border-color:rgba(0,122,204,.4)}&#10; .vsx-top{display:flex;align-items:center;gap:.85rem;padding:1.1rem 1.1rem .6rem;position:relative}&#10; .vsx-icon{flex-shrink:0;width:52px;height:52px;border-radius:12px;overflow:hidden;&#10; display:flex;align-items:center;justify-content:center;background:var(--vsx-bg2);&#10; border:1px solid var(--vsx-line)}&#10; .vsx-icon img{width:100%;height:100%;object-fit:contain;padding:4px}&#10; .vsx-meta{min-width:0}&#10; .vsx-name{font-size:1rem;font-weight:700;line-height:1.2;margin:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}&#10; .vsx-publisher{font-size:.8rem;color:var(--vsx-muted);margin:.1rem 0 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}&#10; .vsx-badge{position:absolute;top:.7rem;right:.7rem;font-size:.62rem;font-weight:800;&#10; letter-spacing:.03em;text-transform:uppercase;color:#fff;&#10; background:linear-gradient(120deg,var(--vsx-accent),var(--vsx-accent2));&#10; padding:.22rem .5rem;border-radius:999px;box-shadow:0 2px 8px rgba(0,122,204,.4)}&#10; .vsx-body{display:flex;flex-direction:column;gap:.35rem;padding:.2rem 1.1rem 1.1rem;flex:1}&#10; .vsx-pitch{font-size:.9rem;line-height:1.5;color:var(--vsx-text);opacity:.92;margin:.1rem 0 .8rem;flex:1}&#10; .vsx-cta{margin-top:auto;display:inline-flex;align-items:center;justify-content:center;gap:.4rem;&#10; font-size:.9rem;font-weight:700;text-decoration:none;color:#fff;&#10; background:linear-gradient(120deg,var(--vsx-accent),var(--vsx-accent2));&#10; padding:.6rem .9rem;border-radius:10px;transition:.18s;box-shadow:0 4px 12px rgba(0,122,204,.28)}&#10; .vsx-cta:hover{filter:brightness(1.06);transform:translateY(-1px);box-shadow:0 6px 18px rgba(0,122,204,.42)}&#10; .vsx-cta svg{width:14px;height:14px;flex-shrink:0}&#10; @media(max-width:520px){&#10; .vsx-grid{grid-template-columns:1fr;gap:.8rem}&#10; .vsx-top{padding:.9rem .9rem .5rem}&#10; .vsx-body{padding:.2rem .9rem .9rem}&#10; }&#10; .vsx-cta:focus-visible{outline:2px solid var(--vsx-accent);outline-offset:3px}&#10; @media(prefers-reduced-motion:reduce){&#10; .vsx-card,.vsx-cta{transition:none}&#10; .vsx-card:hover,.vsx-cta:hover{transform:none}&#10; }&#10; &lt;/style&gt;&#10; &lt;section class="vsx-sec" id="ia-assistente-de-codigo"&gt;&#10; &lt;div class="vsx-sec-head"&gt;&#10; &lt;h1&gt;IA &amp;amp; Assistente de Código&lt;/h1&gt;&#10; &lt;p class="vsx-sec-intro"&gt;Onde a IA entra de verdade no editor: assistente de código e controle do que eu gasto com ele.&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-grid"&gt;&#10; &lt;article class="vsx-card"&gt;&#10; &lt;div class="vsx-top"&gt;&#10; &#10; &lt;div class="vsx-icon"&gt;&#10; &lt;img src="https://gomesfellipe.github.io/img/vscode-extensions/claude-code.png" width="52" height="52"&#10; loading="eager" fetchpriority="high"&#10; alt="Ícone da extensão Claude Code"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-meta"&gt;&#10; &lt;p class="vsx-name"&gt;Claude Code&lt;/p&gt;&#10; &lt;p class="vsx-publisher"&gt;Anthropic&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-body"&gt;&#10; &lt;p class="vsx-pitch"&gt;Lê o projeto, edita arquivos e roda comandos sozinho, direto no terminal ou no editor. Uso pra quase tudo hoje.&lt;/p&gt;&#10; &lt;a class="vsx-cta" href="https://marketplace.visualstudio.com/items?itemName=anthropic.claude-code" target="_blank" rel="noopener noreferrer"&gt;&#10; &lt;svg class="vsx-yt-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"&gt;&lt;path d="M17 2.4 9.6 9.3 5 5.6 2.5 7l4.9 5-4.9 5L5 18.4l4.6-3.7 7.4 6.9L21.5 20V4L17 2.4ZM17 6.8l1.8 1v8.4l-1.8 1-6-4.7 6-4.7Z"/&gt;&lt;/svg&gt;&#10; Ver na Marketplace&#10; &lt;/a&gt;&#10; &lt;/div&gt;&#10; &lt;/article&gt;&#10; &lt;article class="vsx-card"&gt;&#10; &lt;div class="vsx-top"&gt;&#10; &#10; &lt;div class="vsx-icon"&gt;&#10; &lt;img src="https://gomesfellipe.github.io/img/vscode-extensions/claude-usage-tracker.png" width="52" height="52"&#10; loading="eager" fetchpriority="high"&#10; alt="Ícone da extensão Claude Code Usage Tracker"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-meta"&gt;&#10; &lt;p class="vsx-name"&gt;Claude Code Usage Tracker&lt;/p&gt;&#10; &lt;p class="vsx-publisher"&gt;Yahya Shareef&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-body"&gt;&#10; &lt;p class="vsx-pitch"&gt;Mostra quanto eu já gastei de Claude Code direto na barra de status. Sem abrir outra aba pra descobrir a surpresa no fim do mês.&lt;/p&gt;&#10; &lt;a class="vsx-cta" href="https://marketplace.visualstudio.com/items?itemName=yahyashareef.claude-code-usage-tracker" target="_blank" rel="noopener noreferrer"&gt;&#10; &lt;svg class="vsx-yt-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"&gt;&lt;path d="M17 2.4 9.6 9.3 5 5.6 2.5 7l4.9 5-4.9 5L5 18.4l4.6-3.7 7.4 6.9L21.5 20V4L17 2.4ZM17 6.8l1.8 1v8.4l-1.8 1-6-4.7 6-4.7Z"/&gt;&lt;/svg&gt;&#10; Ver na Marketplace&#10; &lt;/a&gt;&#10; &lt;/div&gt;&#10; &lt;/article&gt;&#10; &lt;article class="vsx-card"&gt;&#10; &lt;div class="vsx-top"&gt;&#10; &#10; &lt;div class="vsx-icon"&gt;&#10; &lt;img src="https://gomesfellipe.github.io/img/vscode-extensions/codex.png" width="52" height="52"&#10; loading="eager" fetchpriority="high"&#10; alt="Ícone da extensão Codex"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-meta"&gt;&#10; &lt;p class="vsx-name"&gt;Codex&lt;/p&gt;&#10; &lt;p class="vsx-publisher"&gt;OpenAI&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-body"&gt;&#10; &lt;p class="vsx-pitch"&gt;O agente de código da OpenAI, direto no editor. Uso pra comparar com o Claude Code em tarefas do dia a dia.&lt;/p&gt;&#10; &lt;a class="vsx-cta" href="https://marketplace.visualstudio.com/items?itemName=openai.chatgpt" target="_blank" rel="noopener noreferrer"&gt;&#10; &lt;svg class="vsx-yt-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"&gt;&lt;path d="M17 2.4 9.6 9.3 5 5.6 2.5 7l4.9 5-4.9 5L5 18.4l4.6-3.7 7.4 6.9L21.5 20V4L17 2.4ZM17 6.8l1.8 1v8.4l-1.8 1-6-4.7 6-4.7Z"/&gt;&lt;/svg&gt;&#10; Ver na Marketplace&#10; &lt;/a&gt;&#10; &lt;/div&gt;&#10; &lt;/article&gt;&#10; &lt;/div&gt;&#10; &lt;/section&gt;&#10; &lt;section class="vsx-sec" id="python-r-ciencia-de-dados"&gt;&#10; &lt;div class="vsx-sec-head"&gt;&#10; &lt;h1&gt;Python, R &amp;amp; Ciência de Dados&lt;/h1&gt;&#10; &lt;p class="vsx-sec-intro"&gt;A base do trabalho com dados, em Python e em R: notebooks, formatação automática e o que evita rodar script na mão.&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-grid"&gt;&#10; &lt;article class="vsx-card"&gt;&#10; &lt;div class="vsx-top"&gt;&#10; &lt;span class="vsx-badge"&gt;Essencial&lt;/span&gt;&#10; &lt;div class="vsx-icon"&gt;&#10; &lt;img src="https://gomesfellipe.github.io/img/vscode-extensions/python.png" width="52" height="52"&#10; loading="lazy"&#10; alt="Ícone da extensão Python"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-meta"&gt;&#10; &lt;p class="vsx-name"&gt;Python&lt;/p&gt;&#10; &lt;p class="vsx-publisher"&gt;Microsoft&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-body"&gt;&#10; &lt;p class="vsx-pitch"&gt;Suporte oficial a Python: roda, debuga e troca de ambiente virtual sem sair do editor.&lt;/p&gt;&#10; &lt;a class="vsx-cta" href="https://marketplace.visualstudio.com/items?itemName=ms-python.python" target="_blank" rel="noopener noreferrer"&gt;&#10; &lt;svg class="vsx-yt-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"&gt;&lt;path d="M17 2.4 9.6 9.3 5 5.6 2.5 7l4.9 5-4.9 5L5 18.4l4.6-3.7 7.4 6.9L21.5 20V4L17 2.4ZM17 6.8l1.8 1v8.4l-1.8 1-6-4.7 6-4.7Z"/&gt;&lt;/svg&gt;&#10; Ver na Marketplace&#10; &lt;/a&gt;&#10; &lt;/div&gt;&#10; &lt;/article&gt;&#10; &lt;article class="vsx-card"&gt;&#10; &lt;div class="vsx-top"&gt;&#10; &lt;span class="vsx-badge"&gt;Essencial&lt;/span&gt;&#10; &lt;div class="vsx-icon"&gt;&#10; &lt;img src="https://gomesfellipe.github.io/img/vscode-extensions/pylance.png" width="52" height="52"&#10; loading="lazy"&#10; alt="Ícone da extensão Pylance"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-meta"&gt;&#10; &lt;p class="vsx-name"&gt;Pylance&lt;/p&gt;&#10; &lt;p class="vsx-publisher"&gt;Microsoft&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-body"&gt;&#10; &lt;p class="vsx-pitch"&gt;IntelliSense rápido e checagem de tipos pra Python. Ajuda bastante quando o projeto cresce e fica difícil de navegar sem ele.&lt;/p&gt;&#10; &lt;a class="vsx-cta" href="https://marketplace.visualstudio.com/items?itemName=ms-python.vscode-pylance" target="_blank" rel="noopener noreferrer"&gt;&#10; &lt;svg class="vsx-yt-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"&gt;&lt;path d="M17 2.4 9.6 9.3 5 5.6 2.5 7l4.9 5-4.9 5L5 18.4l4.6-3.7 7.4 6.9L21.5 20V4L17 2.4ZM17 6.8l1.8 1v8.4l-1.8 1-6-4.7 6-4.7Z"/&gt;&lt;/svg&gt;&#10; Ver na Marketplace&#10; &lt;/a&gt;&#10; &lt;/div&gt;&#10; &lt;/article&gt;&#10; &lt;article class="vsx-card"&gt;&#10; &lt;div class="vsx-top"&gt;&#10; &#10; &lt;div class="vsx-icon"&gt;&#10; &lt;img src="https://gomesfellipe.github.io/img/vscode-extensions/black-formatter.png" width="52" height="52"&#10; loading="lazy"&#10; alt="Ícone da extensão Black Formatter"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-meta"&gt;&#10; &lt;p class="vsx-name"&gt;Black Formatter&lt;/p&gt;&#10; &lt;p class="vsx-publisher"&gt;Microsoft&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-body"&gt;&#10; &lt;p class="vsx-pitch"&gt;Formata o código Python no padrão Black ao salvar. Acaba com a discussão sobre estilo de código.&lt;/p&gt;&#10; &lt;a class="vsx-cta" href="https://marketplace.visualstudio.com/items?itemName=ms-python.black-formatter" target="_blank" rel="noopener noreferrer"&gt;&#10; &lt;svg class="vsx-yt-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"&gt;&lt;path d="M17 2.4 9.6 9.3 5 5.6 2.5 7l4.9 5-4.9 5L5 18.4l4.6-3.7 7.4 6.9L21.5 20V4L17 2.4ZM17 6.8l1.8 1v8.4l-1.8 1-6-4.7 6-4.7Z"/&gt;&lt;/svg&gt;&#10; Ver na Marketplace&#10; &lt;/a&gt;&#10; &lt;/div&gt;&#10; &lt;/article&gt;&#10; &lt;article class="vsx-card"&gt;&#10; &lt;div class="vsx-top"&gt;&#10; &lt;span class="vsx-badge"&gt;Essencial&lt;/span&gt;&#10; &lt;div class="vsx-icon"&gt;&#10; &lt;img src="https://gomesfellipe.github.io/img/vscode-extensions/jupyter.png" width="52" height="52"&#10; loading="lazy"&#10; alt="Ícone da extensão Jupyter"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-meta"&gt;&#10; &lt;p class="vsx-name"&gt;Jupyter&lt;/p&gt;&#10; &lt;p class="vsx-publisher"&gt;Microsoft&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-body"&gt;&#10; &lt;p class="vsx-pitch"&gt;Roda notebooks .ipynb dentro do editor mesmo, com gráficos e variáveis aparecendo inline.&lt;/p&gt;&#10; &lt;a class="vsx-cta" href="https://marketplace.visualstudio.com/items?itemName=ms-toolsai.jupyter" target="_blank" rel="noopener noreferrer"&gt;&#10; &lt;svg class="vsx-yt-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"&gt;&lt;path d="M17 2.4 9.6 9.3 5 5.6 2.5 7l4.9 5-4.9 5L5 18.4l4.6-3.7 7.4 6.9L21.5 20V4L17 2.4ZM17 6.8l1.8 1v8.4l-1.8 1-6-4.7 6-4.7Z"/&gt;&lt;/svg&gt;&#10; Ver na Marketplace&#10; &lt;/a&gt;&#10; &lt;/div&gt;&#10; &lt;/article&gt;&#10; &lt;article class="vsx-card"&gt;&#10; &lt;div class="vsx-top"&gt;&#10; &#10; &lt;div class="vsx-icon"&gt;&#10; &lt;img src="https://gomesfellipe.github.io/img/vscode-extensions/r.png" width="52" height="52"&#10; loading="lazy"&#10; alt="Ícone da extensão R"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-meta"&gt;&#10; &lt;p class="vsx-name"&gt;R&lt;/p&gt;&#10; &lt;p class="vsx-publisher"&gt;REditorSupport&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-body"&gt;&#10; &lt;p class="vsx-pitch"&gt;Suporte à linguagem R: terminal integrado, ajuda inline e visualização de dataframe. Resquício da época do blogdown, mas ainda uso direto.&lt;/p&gt;&#10; &lt;a class="vsx-cta" href="https://marketplace.visualstudio.com/items?itemName=reditorsupport.r" target="_blank" rel="noopener noreferrer"&gt;&#10; &lt;svg class="vsx-yt-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"&gt;&lt;path d="M17 2.4 9.6 9.3 5 5.6 2.5 7l4.9 5-4.9 5L5 18.4l4.6-3.7 7.4 6.9L21.5 20V4L17 2.4ZM17 6.8l1.8 1v8.4l-1.8 1-6-4.7 6-4.7Z"/&gt;&lt;/svg&gt;&#10; Ver na Marketplace&#10; &lt;/a&gt;&#10; &lt;/div&gt;&#10; &lt;/article&gt;&#10; &lt;article class="vsx-card"&gt;&#10; &lt;div class="vsx-top"&gt;&#10; &#10; &lt;div class="vsx-icon"&gt;&#10; &lt;img src="https://gomesfellipe.github.io/img/vscode-extensions/rainbow-csv.png" width="52" height="52"&#10; loading="lazy"&#10; alt="Ícone da extensão Rainbow CSV"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-meta"&gt;&#10; &lt;p class="vsx-name"&gt;Rainbow CSV&lt;/p&gt;&#10; &lt;p class="vsx-publisher"&gt;mechatroner&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-body"&gt;&#10; &lt;p class="vsx-pitch"&gt;Colore cada coluna de um CSV/TSV com uma cor diferente e deixa rodar query tipo SQL direto no arquivo. Muda a vida de quem abre CSV cru o dia inteiro.&lt;/p&gt;&#10; &lt;a class="vsx-cta" href="https://marketplace.visualstudio.com/items?itemName=mechatroner.rainbow-csv" target="_blank" rel="noopener noreferrer"&gt;&#10; &lt;svg class="vsx-yt-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"&gt;&lt;path d="M17 2.4 9.6 9.3 5 5.6 2.5 7l4.9 5-4.9 5L5 18.4l4.6-3.7 7.4 6.9L21.5 20V4L17 2.4ZM17 6.8l1.8 1v8.4l-1.8 1-6-4.7 6-4.7Z"/&gt;&lt;/svg&gt;&#10; Ver na Marketplace&#10; &lt;/a&gt;&#10; &lt;/div&gt;&#10; &lt;/article&gt;&#10; &lt;/div&gt;&#10; &lt;/section&gt;&#10; &lt;section class="vsx-sec" id="markdown-escrita"&gt;&#10; &lt;div class="vsx-sec-head"&gt;&#10; &lt;h1&gt;Markdown &amp;amp; Escrita&lt;/h1&gt;&#10; &lt;p class="vsx-sec-intro"&gt;Pra quem escreve mais Markdown do que código: sumário automático e aviso quando a formatação sai torta.&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-grid"&gt;&#10; &lt;article class="vsx-card"&gt;&#10; &lt;div class="vsx-top"&gt;&#10; &#10; &lt;div class="vsx-icon"&gt;&#10; &lt;img src="https://gomesfellipe.github.io/img/vscode-extensions/markdown-all-in-one.png" width="52" height="52"&#10; loading="lazy"&#10; alt="Ícone da extensão Markdown All in One"&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-meta"&gt;&#10; &lt;p class="vsx-name"&gt;Markdown All in One&lt;/p&gt;&#10; &lt;p class="vsx-publisher"&gt;Yu Zhang&lt;/p&gt;&#10; &lt;/div&gt;&#10; &lt;/div&gt;&#10; &lt;div class="vsx-body"&gt;&#10; &lt;p class="vsx-pitch"&gt;Atalhos de formatação, sumário automático e preview pra quem escreve em Markdown o dia inteiro.&lt;/p&gt;&#10; &lt;a class="vsx-cta" href="https://marketplace.visualstudio.com/items?itemName=yzhang.markdown-all-in-one" target="_blank" rel="noopener noreferrer"&gt;&#10; &lt;svg class="vsx-yt-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"&gt;&lt;path d="M17 2.4 9.6 9.3 5 5.6 2.5 7l4.9 5-4.9 5L5 18.4l4.6-3.7 7.4 6.9L21.5 20V4L17 2.4ZM17 6.8l1.8 1v8.4l-1.8 1-6-4.7 6-4.7Z"/&gt;&lt;/svg&gt;&#10; Ver na Marketplace&#10; &lt;/a&gt;&#10; &lt;/div&gt;&#10; &lt;/article&gt;&#10; &lt;article class="vsx-card"&gt;&#10; &lt;div class="vsx-top"&gt;&#10; &#10; &lt;div class="vsx-icon"&gt;&#10; &lt;img src="https://gomesfellipe.github.io/img/vscode-extensions/markdownlint.png" width="52" height="52"&#10; loading="lazy"&#10; alt="Ícone da extensão markdownlint"&gt;